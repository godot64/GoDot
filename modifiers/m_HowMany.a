
	!src <godotlib.lib>
	*= $c000
	!ct pet

; ------------------------------------------------------------
;
;  mod.Howmany
;
;  Module to output the number of colors per tile as digits
;
;  1.00: 29.11.92, first release
;  1.01: 07.10.05, added graphics display
;  1.02, 13.11.18, added colorization
;  1.03, 15.11.18, exchanged btab and qtab,
;                  added STOP from graphics screen
;                  re-init of STOP after display
;  1.04, 20.06.19, added init keyboard for SuperCPU
;        09.08.26, more comments
;  1.05, 10.08.26, changed: don't be forced to re-render in lower color modes
;
; ------------------------------------------------------------

; --------------------------------------------- Declarations

	pport		= $01
	screen		= $0400
	sprptr		= $07f8
	grafreg		= $d011
	multreg		= $d016
	charreg		= $d018
	rahmen		= $d020
	backgr		= $d021

	src		= $35
	dst		= $37
	howmany		= $39
	hmtotal		= $3a
	slot		= $45
	v1buf		= $47
	v2buf		= $48
	cbuf		= $49

	col0		= sc_shadow

	hist		= $c400
	hist2		= hist+16
	vram2		= $ce0b
	vram1		= $de0b
	cstart		= $ee0b

; --------------------------------------------- Header

	jmp start
	!by $20
	!wo 0
	!wo modend
	!wo 0
	!pet "colors/block    "
	!pet "1.05"
	!pet "10.08.26"
	!pet "W.Kling/A.Dettke"

; --------------------------------------------- Main

start	lda gd_modswitch	; save module management byte
	pha
	jsr check		; where is which color buffer?
	jsr evhowmany	; count colors according to the balancing settings
	pla
	sta gd_modswitch	; restore management byte
	lda #0
	sta sc_stop	; init stop key
	sec
	rts

; --------------------------------------------- Howmany

evhowmany	jsr clrscreen	; clear text screen
	lda #<sy_4bit	; set working vectors:
	ldy #>sy_4bit
	sta src		; the colors
	sty src+1
	lda #<screen
	ldy #>screen
	sta dst		; the digits
	sty dst+1

clrhist	lda #0		; clear histograms
	ldy #15
chloop	sta hist,y
	sta hist2,y
	dey
	bpl chloop

	ldy #31		; eine Kachel untersuchen:
hloop	lda gr_cmode	; welcher Grafikmodus? (0: Hires)
	bne hskip

	lda (src),y	; also Hires: a) oberes Nibble (linkes Pixel)
	lsr
	lsr
	lsr
	lsr
	tax
	inc hist2,x	; ungefiltert zählen (alle Farben)
	lda gr_btab,x	; dann Quantisierung berücksichtigen (Anzahl Renderfarben)
	tax
	lda gr_qtab,x	; Balancing berücksichtigen
	tax
	inc hist,x	; und jetzt Farbhäufigkeit zählen

hskip	lda (src),y	; b) unteres Nibble (rechtes Pixel, exklusiv bei Multi)
	and #$0f
	tax
	inc hist2,x	; ungefiltert zählen (über alle Farben)
	lda gr_btab,x	; dann Quantisierung berücksichtigen (Anzahl Renderfarben)
	tax
	lda gr_qtab,x	; Balancing berücksichtigen
	tax
	inc hist,x	; und jetzt Farbhäufigkeit zählen
	dey
	bpl hloop

	lda #0		; Anzahl(en) initialisieren
	sta howmany
	sta hmtotal
	ldy #15		; Anzahl zu berücksichtigender Farben zählen
hmloop	lda hist,y	; wenn Farbe nicht vorgekommen: skip
	beq hmskip
	inc howmany
hmskip	lda hist2,y	; Anzahl über alle Farben zählen (wenn vorgekommen)
	beq hmskip2
	inc hmtotal
hmskip2	dey
	bpl hmloop

	ldx howmany	; wie viele (von den gefilterten)?
	lda chars,x	; nach Hexziffer wandeln (0 bis f; 16=*)
	ldy #0
	sta (dst),y	; in den Screen schreiben
	lda dst+1
	pha

	clc
	adc #$d4		; und im Farbram die Art des Ergebnisses einfärben
	sta dst+1
	lda #8		; 5 (orange, Anzahl ist *gleich* Render-Max-Vorgabe)
	ldx gr_howmany	; nimm Render-Max und
	cpx hmtotal	; vergleiche mit total (aus allen Farben)
	beq ++		; gleich (dann grün, sollte problemlos sein)
	bcs +		; kleiner (dann heller Text, kein Problem bei dieser Kachel)
	lda #2		; sonst 2 (rot, Anzahl ist *größer* als Render-Max-Vorgabe)
	bne ++		; (hier kann es also Color Clashes oder Fehlfärbungen geben)
+	lda sc_light
++	sta (dst),y	; ins Farbram

	pla		; weiter:
	sta dst+1		; zurück zum Textram

	lda src		; nächste Kachel 4Bit anwählen...
	clc
	adc #32
	sta src
	bcc skip0
	inc src+1
skip0	inc dst		; ...und im Textscreen
	bne skip1
	inc dst+1
skip1	lda src+1
	cmp #>sy_bigbuffer	; bis 4Bit-Ende
	beq +
	jmp clrhist	; sonst von vorn, weitermachen

; --------------------------------------------- Wait for STOP

+	lda #0
	sta sc_keyprs	; dann: warten auf Taste
	sta sc_stop
wloop	lda sc_keyprs
	ora sc_stop
	beq wloop
	cmp #1		; Maustaste? Return? Fire?
	beq ++
	cmp #3		; STOP?
	beq +
	cmp #2		; alle anderen: verwerfen
	bne wloop
-
+	rts		; so leave

++	lda gr_redisp	; Render-Modus sichern
	pha		;   (Warnmeldung früher von hier aus: BNE +)
	lda gr_cmode	; auf jeden Fall im Multi mode
	pha
	lda #2
	sta gr_cmode
	lda #0		; init STOP
	sta sc_stop
	sta sc_keyprs
	sta gr_redisp
	jsr redisplay	; Bild zeigen (in Multi, 16 Farben)
	pla
	sta gr_cmode	; alles zurücksetzen
	pla
	sta gr_redisp
	lda sc_stop
	bne -
	jmp evhowmany	; und neu zählen

;+	jsr gd_clrms	; sonst: Warnmeldung (not used anymore)
;	lda #2
;	sta 646
;	ldx #<message
;	ldy #>message
;	jsr gd_xtxout2
;	jmp wloop		; und auf STOP warten

; ---------------------------------------------

clrscreen	lda #15		; Cursorfarbe: hellgrau
	sta 646
	lda #147		; CLR/HOME
	jmp bsout

; --------------------------------------------- Data

chars	!pet "0123456789abcdef*"
message	!scr " Please render graphics first! ",0
list	!wo 0

; ------------------------------------------------ Welche Farben liegen wo?

check	sei 		; GoDot off
	ldx #$00
	stx pport

	ldy #$03		; set lobyte of...
	sty slot

	lda #$f0		; ...Slot4, check for types of module there
	sta slot+1	; (may be cram when input is active)
	jsr sethicol	; (otherwise unchanged)

	lda #$c0		; ...Slot1 and check
	sta slot+1
	jsr sethicol

	lda #$d0		; ...Slot2 and check
	sta slot+1
	jsr sethicol

	lda #$e0		; ...Slot3 and check
	sta slot+1
	jsr sethicol

	lda #$36		; GoDot on again
	sta pport
	cli
	rts

; ------------------------------------------------

sethicol	lda (slot,x)	; get type of module (at $c003): $20, $40, $80
	tay
	and #$40		; is saver there? (contains vram1)
	beq +		; no, next type

	jsr c147		; yes, set color buffer
	sta v1buf
	bne ++

+	tya 		; loader? ($80, contains cram)
	bpl +		; no, next type

	jsr c147		; yes, set accordingly
	sta cbuf
	bne ++

+	jsr c147		; so, it's a modifier (contains vram2)
	sta v2buf

++	rts

c147 	lda slot+1	; get hibyte...
	ora #$0e		; ...and OR %00001110 to it (ie $ce)
	rts 		; thus: get correct hi address of color buffers

; ------------------------------------------------
; ------------------------------------------------ graphics display
; ------------------------------------------------

redisplay	ldx gr_palette	; set border to color 0 (normally black)
	stx rahmen
	jsr setcolors	; get colors from their buffers

	lda gr_cmode	; which mode?
	beq dp4
	lda #$18		; multicolor
	sta multreg
dp4	lda #$1b		; hires
	sta charreg
	lda #$3b
	sta grafreg
	lda gr_redisp	; Flag: display graphics set?
	bne dp3		; yes, branch and leave

-	lda sc_keyprs
	ora sc_stop
	beq -

; ------------------------------------------------ End display

dp2	jsr getcolors	; no, end display: save colors
	jsr tmode		; activate textmode
dp3	clc		; leave
	rts

; ------------------------------------------------ Switch textmode on

tmode	ldx #$13
	lda #$1b
	stx charreg
	sta grafreg
	lda #$08
	sta multreg
	lda sc_maincolor
	sta rahmen
	sta backgr
	rts

; ------------------------------------------------
; ------------------------------------------------
; Routines to handle GoDot's graphics color buffers
; for comments see sources for god.upmem
; ------------------------------------------------
; ------------------------------------------------

setcveks	sei
	lda #$35
	sta pport
	lda cbuf 		; color ram
	ldx #$d8
	bne scv0
setbveks	lda v1buf 	; vram1
	ldx #4
	dec pport
scv0	stx ls_adrmisc+1
	ldy #0
	sty sc_merk
	sty ls_adrmisc
	dey
setlast	sty gr_bkcol
	ldy #<(cstart)
	sty sc_vekt20
	sta sc_vekt20+1
	lda #<(500)
	sta ls_vekta8
	lda #>(500)
	sta ls_vekta8+1
	ldy #0
	rts

count	inc sc_vekt20
	bne cou5
	inc sc_vekt20+1
cou5	inc ls_adrmisc
	bne cou6
	inc ls_adrmisc+1
cou6	lda ls_vekta8
	bne cou7
	dec ls_vekta8+1
cou7	dec ls_vekta8
	lda ls_vekta8
	ora ls_vekta8+1
	rts

getcolors	jsr setcveks
stco	lda (ls_adrmisc),y
	sta sc_merk
	inc ls_adrmisc
	bne stc0
	inc ls_adrmisc+1
stc0	lda (ls_adrmisc),y
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	lda sc_merk
	sta (sc_vekt20),y
	jsr count
	bne stco
	jsr setbveks
stc1	lda (ls_adrmisc),y
	sta (sc_vekt20),y
	jsr count
	bne stc1
	ldy gr_bkcol
	bpl scv1
	ldy #0
	lda v2buf 	; vram2
	jsr setlast
	beq stc1
scv1	lda #$36
	sta pport
	cli
	lda backgr
	and #15
	sta gr_bkcol
	rts

setcolors	lda gr_bkcol
	sta backgr
	pha
	jsr setcveks
stc2	sty sc_merk
	lda (sc_vekt20),y
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	lsr
	rol sc_merk
	sta (ls_adrmisc),y
	inc ls_adrmisc
	bne stc3
	inc ls_adrmisc+1
stc3	lda sc_merk
	sta (ls_adrmisc),y
	jsr count
	bne stc2
	jsr setbveks
stc4	lda (sc_vekt20),y
	sta (ls_adrmisc),y
	jsr count
	bne stc4
	ldy gr_bkcol
	bpl scv1
	pla
	tay
	lda v2buf 	; vram2
	jsr setlast
	beq stc4

; ---------------------------------------------

modend	!eof
